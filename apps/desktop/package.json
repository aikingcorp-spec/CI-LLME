{
  "name": "@rakazo/desktop",
  "productName": "VNBot",
  "version": "0.4.0",
  "author": {
    "name": "VNBot"
  },
  "homepage": "https://vnbot.run",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "node scripts/build.mjs && node scripts/copy-static.mjs && node scripts/build-speech.mjs",
    "build:native": "node scripts/build-native.mjs",
    "pack": "pnpm --filter @rakazo/web build && pnpm build && electron-builder --mac --win --linux",
    "pack:dir": "pnpm --filter @rakazo/web build && pnpm build && electron-builder --dir",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.jsdom.json && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "release": "pnpm --filter @rakazo/web build && pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@rakazo/auth": "workspace:*",
    "@rakazo/contracts": "workspace:*",
    "@rakazo/logging": "workspace:*",
    "@sentry/electron": "8.3.0",
    "electron-updater": "6.8.12",
    "koffi": "3.3.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@rakazo/adapters": "workspace:*",
    "@rakazo/core": "workspace:*",
    "@rakazo/ui-tokens": "workspace:*",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "build": {
    "appId": "run.vnbot.desktop",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../infra/compose/docker-compose.images.yml",
        "to": "stack/docker-compose.images.yml"
      },
      {
        "from": "../../infra/compose/.env.images.example",
        "to": "stack/.env.images.example"
      },
      {
        "from": "build",
        "to": ".",
        "filter": [
          "native/**/*"
        ]
      }
    ],
    "extraMetadata": {
      "name": "vnbot",
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "x64ArchFiles": "{**/app.asar.unpacked/node_modules/**,**/node_modules/@koromix/koffi-darwin-*/darwin_*/koffi.node,**/node_modules/@oxc-parser/binding-darwin-*/parser.darwin-*.node,**/Resources/native/node_modules/.pnpm/**}",
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "VNBot uses the microphone for dictation and voice calls with your bots.",
        "NSSpeechRecognitionUsageDescription": "VNBot turns what you say into text for dictation and voice calls with your bots."
      },
      "extraResources": [
        {
          "from": "build/speech/rakazo-speech",
          "to": "speech/rakazo-speech"
        },
        {
          "from": "assets/es.lproj",
          "to": "es.lproj"
        },
        {
          "from": "assets/pl.lproj",
          "to": "pl.lproj"
        }
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": true
    },
    "dmg": {
      "title": "${productName}",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 175,
          "type": "file"
        },
        {
          "x": 490,
          "y": 175,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "win": {
      "icon": "assets/icon-vnbot.png",
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "msi",
          "arch": "x64"
        }
      ],
      "verifyUpdateCodeSignature": true
    },
    "linux": {
      "executableName": "vnbot",
      "icon": "assets/icon-vnbot.png",
      "maintainer": "VNBot <hello@vnbot.run>",
      "vendor": "VNBot",
      "target": [
        {
          "target": "AppImage",
          "arch": "x64"
        },
        {
          "target": "deb",
          "arch": "x64"
        }
      ],
      "desktop": {
        "entry": {
          "Name": "VNBot",
          "StartupWMClass": "VNBot"
        }
      }
    },
    "msi": {
      "oneClick": false,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://dl.vnbot.run/desktop/"
      }
    ]
  }
}
