---
import "../styles/global.css";
import { VNBOT_CANONICAL_ORIGIN } from "../vnbot-help";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  markdownPath: string;
}

const { title, description, canonicalPath, markdownPath } = Astro.props;
const canonical = new URL(canonicalPath, VNBOT_CANONICAL_ORIGIN).toString();
const pageTitle = `${title} | VNBot`;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={markdownPath} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="VNBot" />
    <meta property="og:locale" content="vi_VN" />
  </head>
  <body>
    <a class="skip-link" href="#main">Tới nội dung</a>
    <header class="vnbot-help-bar">
      <a href="/help/">VNBot</a>
      <span>Hướng dẫn</span>
      <a href={VNBOT_CANONICAL_ORIGIN}>vnbot.run</a>
    </header>
    <div class="docs-shell docs">
      <slot />
    </div>
  </body>
</html>

<style>
  .vnbot-help-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 57px;
    padding: 0 24px;
    border-bottom: 1px solid var(--line);
    background: var(--page);
    color: var(--ink);
  }
  .vnbot-help-bar a {
    color: inherit;
    font-weight: 500;
    text-decoration: none;
  }
  .vnbot-help-bar span {
    color: var(--muted);
  }
  .vnbot-help-bar a:last-child {
    margin-left: auto;
  }
</style>
