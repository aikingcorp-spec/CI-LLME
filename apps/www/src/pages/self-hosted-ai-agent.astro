---
import Button from "../components/Button.astro";
import FaqSection from "../components/FaqSection.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {
  faqPageStructuredData,
  SELF_HOST_DESCRIPTION,
  SELF_HOST_FAQS,
  SELF_HOST_H1,
  SELF_HOST_REQUIREMENTS,
  SELF_HOST_SERVER,
  SELF_HOST_STEPS,
  SELF_HOST_TITLE,
} from "../guide";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ogPublicPath } from "../og-pages";
import { DOWNLOAD_URL, OPENCLAW_ALTERNATIVE_PATH, SUPPORT_EMAIL } from "../site";

const structuredData = faqPageStructuredData(SELF_HOST_FAQS);
---

<BaseLayout
  title={SELF_HOST_TITLE}
  description={SELF_HOST_DESCRIPTION}
  {structuredData}
  localeAlternates={false}
  ogImage={ogPublicPath("self-hosted-ai-agent")}
>
  <div class="container">
    <Header />
    <main id="main" class="privacy-copy guide">
      <h1>{SELF_HOST_H1}</h1>
      <p>Run VNBot on your own Mac, PC, or VPS. Your chats and data stay on your machine.</p>

      <h2>Steps</h2>
      <ol>
        {SELF_HOST_STEPS.map((step) => <li><strong>{step.title}.</strong> {step.body}</li>)}
      </ol>
      <div class="cta-actions">
        <Button href={DOWNLOAD_URL}>Download VNBot</Button>
      </div>

      <h2>Before you start</h2>
      <p>{SELF_HOST_REQUIREMENTS}</p>

      <h2>Always-on machine</h2>
      <p>
        {SELF_HOST_SERVER} For help, email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
      </p>

      <FaqSection items={SELF_HOST_FAQS} />

      <h2>Related</h2>
      <ul>
        <li><a href="/">VNBot home</a></li>
        <li><a href={OPENCLAW_ALTERNATIVE_PATH}>OpenClaw comparison</a></li>
      </ul>
    </main>
    <Footer />
  </div>
</BaseLayout>
