---
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { DOCS_PATH } from "../docs";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found · VNBot"
  description="The requested VNBot page does not exist."
  index={false}
>
  <div class="container">
    <Header />
    <main id="main" class="privacy-copy">
      <h1>Page not found</h1>
      <p>The page you requested does not exist. Return home or read the docs.</p>
      <div class="cta-actions">
        <Button href="/">Home</Button>
        <Button href={DOCS_PATH} variant="secondary">Read the docs</Button>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
