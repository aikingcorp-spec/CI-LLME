---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { APP_URL } from "../site";
---

<BaseLayout title="Support · VNBot" description="Get help with the VNBot app and your VNBot account.">
  <div class="container">
    <Header />
    <main id="main" class="privacy-copy">
      <h1>VNBot support</h1>
      <p>
        For help with the VNBot mobile app or a hosted VNBot account, email{" "}
        <a href="mailto:hello@rakazo.com">hello@rakazo.com</a>. Include the email address on your
        account, what you expected to happen, and any error message you saw. Do not send passwords, API keys,
        access tokens, or other secrets.
      </p>
      <h2 id="account-deletion">Account deletion</h2>
      <p>
        In the mobile app, open <strong>Account</strong>, enter your current password under{" "}
        <strong>Delete account</strong>, and confirm. On the web, sign in at{" "}
        <a href={APP_URL}>vnbot.run</a> and do the same under{" "}
        <strong>Settings</strong> → <strong>Account</strong>. This permanently deletes the hosted account and its
        associated personal Space data.
      </p>
      <p>
        Without access to the app, email <a href="mailto:hello@rakazo.com">hello@rakazo.com</a> from your account's
        email address to ask us to delete it. Sign-in security records are kept for up to 90 days.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
