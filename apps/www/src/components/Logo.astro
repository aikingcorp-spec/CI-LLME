---
type Props = {
  href?: string;
  label?: string;
};

const { href = "/", label = "VNBot home" } = Astro.props as Props;
---

<a class="brand-lockup" href={href} aria-label={label}>
  <img
    class="brand-lockup__mark"
    src="/landing/img/vnbot-app-icon-128.png"
    width="36"
    height="36"
    alt=""
    aria-hidden="true"
  />
  <span class="brand-lockup__word">VNBot</span>
</a>
