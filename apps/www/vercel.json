{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": { "eq": "www.vnbot.run" } }],
      "destination": "https://vnbot.run/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": { "eq": "www.vnbot.run" } }],
      "destination": "https://vnbot.run/:path*",
      "statusCode": 301
    }
  ]
}
